{
  "name": "crypto-arbitrage-miniapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "USE_MOCK_DATA=false npm run dev:backend",
    "dev:backend": "npx cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start": "NODE_ENV=production USE_MOCK_DATA=false node dist-backend/index.js",
    "start:production": "NODE_ENV=production USE_MOCK_DATA=false node dist-backend/index.js",
    "test:local": "NODE_ENV=production npm start",
    "preview": "vite preview",
    "lint": "eslint src",
    "migrate": "tsx scripts/migrate-to-postgres.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@types/pg": "^8.15.5",
    "axios": "^1.13.1",
    "ccxt": "^4.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.0",
    "helmet": "^8.1.0",
    "i18next": "^23.7.0",
    "i18next-fs-backend": "^2.6.0",
    "node-cron": "^3.0.0",
    "node-telegram-bot-api": "^0.63.0",
    "pg": "^8.16.3",
    "sqlite3": "^5.1.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^8.45.0",
    "tsx": "^4.20.6",
    "vite": "^7.2.2"
  }
}
